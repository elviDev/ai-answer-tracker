# --- Web dashboard (web/) and API security ---
# Shared secret: the Next.js server sends it to the API, so the API rejects everyone else.
# Generate one with: openssl rand -base64 24
API_TOKEN=
# Used by docker compose for the web service (for local dev put these in web/.env.local).
SESSION_SECRET=
ADMIN_PASSWORD=
SITE_URL=http://localhost:3000

# Used when running outside Docker (docker-compose overrides it).
DATABASE_URL=postgresql+psycopg://tracker:tracker@localhost:5432/tracker

# Engines a tracker uses when it doesn't list its own (JSON list).
# Available: openai, claude, gemini, perplexity_api (APIs)
#            perplexity, chatgpt, google_ai_overview (browser scraping), mock
DEFAULT_ENGINES=["perplexity","chatgpt","google_ai_overview"]

# --- Official provider APIs (recommended: reliable, no CAPTCHAs) ---
# Each API engine switches on once its key is set. Models can be overridden.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-6-astra
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GEMINI_GROUNDING=true   # false = free tier, no live Google Search
PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar
# API_TIMEOUT_SECONDS=180

# --- Browser scraping ---
HEADLESS=true
BROWSER_TIMEOUT_SECONDS=90
ANSWER_SETTLE_SECONDS=3
# SCREENSHOT_DIR=screenshots

WORKER_POLL_SECONDS=60
