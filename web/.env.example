# Public URL of this site, used for canonical URLs, sitemap, robots and JSON-LD.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# FastAPI backend, reached server-side only (the browser never calls it directly).
API_URL=http://localhost:8000
# Must match API_TOKEN in the backend's .env (leave both empty to disable).
API_TOKEN=

# Session cookie signing key, at least 32 characters: openssl rand -base64 32
SESSION_SECRET=
# Password for the dashboard login.
ADMIN_PASSWORD=
